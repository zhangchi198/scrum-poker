{
  "name": "scrum-poker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted real-time scrum poker (planning poker).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"node --watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
